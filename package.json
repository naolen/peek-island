{
  "name": "peek-island",
  "version": "0.3.0",
  "description": "余光：贴在 Windows 屏幕顶部的光带 / 灵动岛式盯盘工具",
  "keywords": [
    "windows",
    "dynamic-island",
    "stock",
    "stock-ticker",
    "a-share",
    "eastmoney",
    "electron",
    "desktop-widget",
    "灵动岛",
    "盯盘"
  ],
  "homepage": "https://github.com/naolen/peek-island#readme",
  "bugs": {
    "url": "https://github.com/naolen/peek-island/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naolen/peek-island.git"
  },
  "main": "src/main.js",
  "author": {
    "name": "naolen",
    "url": "https://github.com/naolen"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "native": "dotnet publish native/PeekNative/PeekNative.csproj -c Release -o native/publish",
    "dist": "electron-builder --win nsis portable --x64 --publish never",
    "smoke": "xvfb-run -a electron --no-sandbox scripts/smoke.js ./shots"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "hoodiecrow-imap": "^3.3.1"
  },
  "build": {
    "appId": "com.naolen.peekisland",
    "productName": "余光",
    "artifactName": "peek-island-setup-${version}.${ext}",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/publish",
        "to": "native",
        "filter": [
          "PeekNative.exe"
        ]
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "余光",
      "artifactName": "peek-island-setup-${version}.${ext}"
    },
    "executableName": "PeekIsland",
    "portable": {
      "artifactName": "peek-island-portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.3"
  },
  "engines": {
    "node": ">=20"
  }
}
